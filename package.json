{
  "name": "birdeye-cop",
  "version": "1.0.0",
  "private": true,
  "description": "Discord voice-channel moderation bot: per-speaker transcription, banned-term matching, and automated moderation actions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsx src/scripts/setup.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "spike:voice": "tsx src/scripts/spike-voice-receive.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "prompts": "^2.4.2",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@discordjs/opus@0.10.0": true,
    "better-sqlite3@13.0.3": true
  }
}
