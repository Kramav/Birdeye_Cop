###############################################################################
# Birdeye_Cop — configuration
#
# Copy to `.env` and fill in, or run `npm run setup` to generate it
# interactively. Run `npm run doctor` at any point to check the result.
#
# Only the five variables in REQUIRED need values. Everything below that has a
# working default.
###############################################################################

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Text channel that receives moderation reports.
# Enable Developer Mode in Discord, then right-click the channel -> Copy ID.
MODERATION_LOG_CHANNEL_ID=

# mock | openai | deepgram
#   mock     — no credentials, no network. Use this first.
#   openai   — any OpenAI-compatible endpoint (OpenAI, Groq, local whisper.cpp)
#   deepgram — lowest latency, native per-word confidence
STT_PROVIDER=mock

# Not needed for `mock`, nor for a local whisper.cpp server on localhost.
STT_API_KEY=


# ─── DISCORD SCOPE ───────────────────────────────────────────────────────────

# Restrict to specific servers (comma-separated). Empty = every server the bot
# is in.
GUILD_IDS=

# Voice channels to monitor (comma-separated). Empty is fine — `/moderation
# join` adds the channel you are in and remembers it.
#
# There is deliberately no "monitor everything" setting: nobody should be
# transcribed because an operator forgot to narrow a default.
MONITORED_VOICE_CHANNEL_IDS=

# Role permitted to use /moderation, in addition to anyone with Manage Server.
MODERATOR_ROLE_ID=

# Join a monitored channel automatically when someone enters it.
AUTO_JOIN=true
AUTO_LEAVE_WHEN_EMPTY=true


# ─── MODERATION ──────────────────────────────────────────────────────────────

MODERATION_ENABLED=true

# The MOST SEVERE action moderation may take: warn | disconnect | kick | ban.
# Repeat offences escalate up the ladder toward this ceiling.
MODERATION_ACTION=disconnect

# Log violations without acting on them. Leave this on until you have watched
# the logs for a while and are satisfied with the false-positive rate.
DRY_RUN=true

# Escalation: 1st offence warns, then disconnect, then kick. High-severity
# rules start one rung higher.
ESCALATION_ENABLED=true
ESCALATION_WINDOW_HOURS=24

# Permit fully automated permanent bans.
#
# Off by default on purpose. Speech recognition of noisy voice chat is not
# accurate enough to make an irreversible decision with no human in the loop;
# with this off, an escalation that reaches `ban` is applied as `kick` and
# flagged in the log for a human to review.
ALLOW_UNATTENDED_BAN=false

# Below this confidence, a match is re-transcribed with the verify model and
# only acted on if both passes agree. 0..1.
CONFIDENCE_THRESHOLD=0.6

# Window in which repeated equivalent transcripts are treated as one event.
DEDUPE_TTL_MS=10000

MODERATION_CONFIG_PATH=./config/moderation.json


# ─── PRIVACY AND CONSENT ─────────────────────────────────────────────────────

# Post a notice in the voice channel stating that speech is being transcribed.
# When enabled, the bot REFUSES TO JOIN a channel where it cannot post.
#
# Read the Legal and consent section of the README before turning this off.
# Recording or processing a conversation without informing participants is
# unlawful in a number of jurisdictions regardless of who owns the server.
REQUIRE_MONITORING_NOTICE=true

# Store transcribed speech in logs and moderation records.
# Off by default: only a non-reversible hash is kept.
TRANSCRIPT_LOGGING=false


# ─── SPEECH-TO-TEXT ──────────────────────────────────────────────────────────

# For STT_PROVIDER=openai. Defaults to https://api.openai.com/v1
#   Groq:           https://api.groq.com/openai/v1
#   local whisper:  http://localhost:8080/v1   (whisper.cpp `whisper-server`)
STT_BASE_URL=

# Defaults: openai -> gpt-4o-mini-transcribe, deepgram -> nova-3
STT_MODEL=

# ISO-639-1 hint, e.g. `en`. Improves accuracy and latency when known.
STT_LANGUAGE=

# Second-opinion pass for low-confidence matches. Auto-selected to a DIFFERENT
# model when left blank — re-running identical audio through identical weights
# reproduces the same mistake, so agreement would prove nothing.
STT_VERIFY_PROVIDER=
STT_VERIFY_MODEL=

# Concurrent transcription requests. Defaults are provider-aware: 8 for cloud
# providers, 2 for a local whisper server on localhost (one GPU serializes).
STT_MAX_CONCURRENCY=

STT_TIMEOUT_MS=8000

# Queue depth. On overflow the LONGEST per-speaker queue sheds work and the
# drop is reported as STT_DEGRADED — never silently, so "no violations" is
# never confused with "nothing was heard".
STT_QUEUE_MAX=32

# Consecutive failures before the circuit opens. While open, NO moderation
# action is taken: an unavailable transcription service must never cause kicks.
STT_BREAKER_THRESHOLD=5
STT_BREAKER_RESET_MS=30000


# ─── VOICE CAPTURE AND SEGMENTATION ──────────────────────────────────────────

# Silence that ends a receive subscription.
VAD_SILENCE_MS=400

# Grace period for re-attaching a stream that was cut mid-speech
# (discordjs/discord.js#8105). Only applied when the audio ended while the
# speaker still had energy, so ordinary speech pays no delay.
SEGMENT_COALESCE_MS=600

MIN_SPEECH_MS=300
MAX_SEGMENT_MS=10000

# Normalized RMS (0..1) below which audio counts as silence.
VAD_ENERGY_THRESHOLD=0.02

# Transmit one silence frame on join. Long-standing workaround for the receive
# path not opening until the bot has sent something.
VOICE_SILENCE_KEEPALIVE=true

# Alert if speaking events arrive but no audio is ever decoded — the signature
# of a broken voice-receive path, which otherwise looks exactly like a quiet
# channel.
VOICE_LIVENESS_TIMEOUT_MS=30000


# ─── VIOLATION AUDIO EVIDENCE (off by default) ───────────────────────────────

# Save the specific clip that triggered an action. Only the violating
# speaker's own audio is written, never the mixed channel.
VIOLATION_AUDIO_LOGGING=false

# Required to start with VIOLATION_AUDIO_LOGGING=true. Recordings of an
# identifiable voice are treated as biometric data in some jurisdictions —
# Illinois BIPA provides statutory damages per violation with no injury
# required. See docs/PRIVACY.md.
I_ACKNOWLEDGE_BIOMETRIC_RISK=false

VIOLATION_AUDIO_DIRECTORY=./violation-audio
VIOLATION_AUDIO_RETENTION_DAYS=7
VIOLATION_AUDIO_PREBUFFER_MS=1000
VIOLATION_AUDIO_POSTBUFFER_MS=500

# Delay the action by the post-buffer so real trailing audio is captured.
# Off: the action is immediate and post-roll is silence-padded, because a
# disconnected user stops transmitting at once.
VIOLATION_AUDIO_DELAY_ACTION=false

# Attach evidence audio to /moderation evidence replies.
# Off by default: uploading places the recording on Discord's CDN, which is at
# odds with treating it as private moderation evidence.
EVIDENCE_ALLOW_DISCORD_UPLOAD=false


# ─── STORAGE ─────────────────────────────────────────────────────────────────

# auto | sqlite | jsonl | memory
# `auto` prefers SQLite and falls back to JSONL if the native module is
# unavailable, so a failed build degrades the deployment instead of stopping it.
STORAGE_DRIVER=auto
DATABASE_PATH=./data/birdeye-cop.db

MODERATION_LOG_RETENTION_DAYS=90
RETENTION_SWEEP_INTERVAL_MS=3600000


# ─── OPERATIONS ──────────────────────────────────────────────────────────────

LOG_LEVEL=info
LOG_PRETTY=false

# Exit at startup if a required permission is missing, instead of downgrading
# the action to `warn` and continuing.
STRICT_PERMISSIONS=false
